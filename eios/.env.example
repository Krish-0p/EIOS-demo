# EIOS Environment Variables — copy to .env and fill in REAL values
# Generate passwords: openssl rand -base64 32  or  [Convert]::ToBase64String(([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32)))

# ── PostgreSQL ────────────────────────────────────────────────────────────────
EIOS_POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
EIOS_POSTGRES_USER=eios
EIOS_POSTGRES_DB=eios
EIOS_POSTGRES_DSN=postgresql://eios:REPLACE_WITH_STRONG_PASSWORD@eios-postgres:5432/eios

# ── API Security ──────────────────────────────────────────────────────────────
# Leave empty to disable API key enforcement (dev mode)
# Set to a 32+ char random string for production
EIOS_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
EIOS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Dashboard ────────────────────────────────────────────────────────────────
VITE_API_BASE=http://127.0.0.1:8000

# ── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_ADDR=kafka:9092

# ── Logging & Security Features ──────────────────────────────────────────────
EIOS_LOG_LEVEL=INFO
EIOS_REDACTION_ENABLED=true
EIOS_AUDIT_INTEGRITY_ENABLED=true
EIOS_RATE_LIMIT_REQUESTS=200
EIOS_RATE_LIMIT_WINDOW=60
EIOS_MAX_REQUEST_BYTES=1048576
LOG_RETENTION_DAYS=90
